{
  "name": "auto-rubrica-moodle",
  "version": "1.0.0",
  "description": "Crea rúbricas en Moodle desde archivos .md o .csv (aplicación para Windows y línea de comandos)",
  "type": "module",
  "bin": {
    "auto-rubrica": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "app": "electron .",
    "build:win": "electron-builder --win portable --publish never",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "main": "app/main.js",
  "productName": "Auto Rubrica Moodle",
  "build": {
    "appId": "com.resuacode.autorubricamoodle",
    "productName": "Auto Rubrica Moodle",
    "files": [
      "app/**",
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AutoRubricaMoodle-${version}.exe"
    }
  }
}
