{
  "name": "auto-rubrica-moodle",
  "version": "1.1.0",
  "description": "Crea rúbricas en Moodle desde archivos .md o .csv (aplicación de escritorio y línea de comandos)",
  "type": "module",
  "bin": {
    "auto-rubrica": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "app": "electron .",
    "build:win": "electron-builder --win --publish never",
    "test": "node --test test/*.test.js",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "main": "app/main.js",
  "productName": "Auto Rubrica Moodle",
  "build": {
    "appId": "com.resuacode.autorubricamoodle",
    "productName": "Auto Rubrica Moodle",
    "files": [
      "app/**",
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AutoRubricaMoodle-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "synopsis": "Crea rúbricas en Moodle desde archivos .md o .csv",
      "maintainer": "resuacode",
      "artifactName": "AutoRubricaMoodle-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "AutoRubricaMoodle-${version}-mac-${arch}.${ext}"
    }
  },
  "author": "resuacode",
  "homepage": "https://github.com/resuacode/auto-rubrica-moodle"
}
